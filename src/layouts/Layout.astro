---
interface Props {
  title?: string;
  description?: string;
}
const {
  title = 'A Step Above Kitchen & Bath Design | Herrin, IL',
  description = 'Kitchen remodeler in Herrin, Illinois. 3108 S Park Ave. Call (618) 942-2000. Wheelchair accessible entrance and parking.',
} = Astro.props;
const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : import.meta.env.BASE_URL + '/';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#1B2430" />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Nunito+Sans:ital,opsz,wght@0,6..12,400;0,6..12,600;0,6..12,700;0,6..12,800;1,6..12,400&family=Playfair+Display:ital,wght@0,500;0,600;0,700;1,500&display=swap"
      rel="stylesheet"
    />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  :root {
    --navy: #1b2430;
    --navy-2: #243040;
    --ink: #1e2633;
    --muted: #6a7382;
    --line: #e2e0db;
    --cream: #f7f5f2;
    --cream-2: #efebe4;
    --white: #ffffff;
    --walnut: #a67c52;
    --walnut-hot: #b88b5f;
    --display: 'Playfair Display', Georgia, serif;
    --font: 'Nunito Sans', system-ui, sans-serif;
    --max: 1140px;
  }
  *, *::before, *::after { box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  body {
    margin: 0;
    font-family: var(--font);
    color: var(--ink);
    background: var(--cream);
    line-height: 1.55;
    -webkit-font-smoothing: antialiased;
  }
  img { max-width: 100%; display: block; }
  a { color: inherit; text-decoration: none; }
  button, input, textarea { font: inherit; }
  h1, h2, h3 {
    font-family: var(--display);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.15;
  }
  .wrap {
    width: min(var(--max), calc(100% - 2rem));
    margin-inline: auto;
  }
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    border-radius: 999px;
    padding: 0.9rem 1.25rem;
    font-weight: 800;
    font-size: 0.95rem;
    border: 2px solid transparent;
    cursor: pointer;
    transition: background .15s, border-color .15s, color .15s, transform .15s;
  }
  .btn:hover { transform: translateY(-1px); }
  .btn-walnut {
    background: var(--walnut);
    color: #fff;
  }
  .btn-walnut:hover { background: var(--walnut-hot); }
  .btn-navy {
    background: var(--navy);
    color: #fff;
  }
  .btn-line {
    background: transparent;
    color: var(--navy);
    border-color: var(--line);
  }
  .btn-line:hover {
    border-color: var(--walnut);
    color: var(--walnut);
  }
  .btn-ghost {
    background: transparent;
    color: #fff;
    border-color: rgba(255,255,255,.35);
  }
  .btn-ghost:hover {
    border-color: var(--walnut-hot);
    color: var(--walnut-hot);
  }
  :focus-visible {
    outline: 3px solid var(--walnut);
    outline-offset: 2px;
  }
</style>
